# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5180
# Production (Render): public URL of this API — used for product image links
# PUBLIC_API_URL=https://your-service.onrender.com

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ferilo
# Neon example:
# DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change-me-use-a-long-random-string-in-production
JWT_REFRESH_SECRET=change-me-use-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Storage ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
PRODUCT_IMAGE_DIR=./uploads/products
IDENTITY_DOC_DIR=./uploads/identity
MAX_PRODUCT_IMAGES=8
MAX_IMAGE_SIZE_MB=5
MAX_ID_DOC_SIZE_MB=10

# ─── Admin bootstrap (Phase 2 seed) ───────────────────────
ADMIN_EMAIL=admin@ferilo.local
ADMIN_PASSWORD=change-me-on-first-login

# ─── Email (mock in MVP — logs to console) ────────────────
EMAIL_FROM=noreply@ferilo.local
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ─── Rate limiting (dev-friendly defaults; tighten in production) ─
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=2000
AUTH_RATE_LIMIT_MAX=100

# ─── Frontend (Cloudflare Pages build-time) ───────────────
# Set in Cloudflare dashboard, not required locally (Vite proxy):
# VITE_API_URL=https://your-service.onrender.com
